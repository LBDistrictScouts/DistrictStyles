{
    "name": "@lbdistrictscouts/district-styles",
    "version": "0.2.1",
    "description": "SCSS & Bootstrap Styles for District Projects.",
    "author": "Jacob Tyler <JacobAGTyler@users.noreply.github.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/LBDistrictScouts/DistrictStyles.git"
    },
    "homepage": "https://github.com/LBDistrictScouts/DistrictStyles#readme",
    "bugs": {
        "url": "https://github.com/LBDistrictScouts/DistrictStyles/issues"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "files": [
        "dist/**",
        "scss/**",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        "./css": "./dist/css/district-styles.css",
        "./css/min": "./dist/css/district-styles.min.css",
        "./dist/css/district-styles.css": "./dist/css/district-styles.css",
        "./dist/css/district-styles.min.css": "./dist/css/district-styles.min.css",
        "./scss": "./scss/style.scss",
        "./scss/*": "./scss/*"
    },
    "scripts": {
        "clean": "rimraf dist",
        "build:css": "sass scss/style.scss dist/css/district-styles.css --style=expanded --source-map --load-path=node_modules --load-path=node_modules/bootstrap/scss",
        "build:css:min": "sass scss/style.scss dist/css/district-styles.min.css --style=compressed --no-source-map --load-path=node_modules --load-path=node_modules/bootstrap/scss",
        "build": "yarn clean && yarn build:css && yarn build:css:min",
        "prepublishOnly": "yarn build"
    },
    "dependencies": {
        "@popperjs/core": "^2.11.8",
        "bootstrap": "^5.3.8"
    },
    "devDependencies": {
        "rimraf": "^6.1.3",
        "sass": "^1.98.0"
    }
}
