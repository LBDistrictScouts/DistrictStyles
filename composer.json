{
    "name": "lbdistrictscouts/district-ui",
    "description": "DistrictUI CakePHP plugin",
    "version": "0.1.x-dev",
    "type": "cakephp-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "cakephp/cakephp": "^5.3",
        "friendsofcake/bootstrap-ui": "^5.1"
    },
    "autoload": {
        "psr-4": {
            "DistrictUI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DistrictUI\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test:plugin": "vendor/bin/phpunit --configuration phpunit.xml.dist",
        "test": [
            "@test:plugin"
        ]
    }
}
